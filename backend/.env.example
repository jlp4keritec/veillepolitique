# ============================================================
# VEILLE - modele de configuration
# Ce fichier est recopie en backend\.env au premier lancement.
# Le fichier .env ne va JAMAIS dans git (voir .gitignore).
# ============================================================

# --- Secrets (a renseigner vous-meme dans .env, jamais dans le chat) ---
ANTHROPIC_API_KEY=
# OpenRouter (Mistral, Gemini, GPT... via un seul compte) - facultatif
OPENROUTER_API_KEY=
# Serveur MCP (lecture seule) pour Claude / LILY : jeton long (scripts/generer_jeton_mcp.py). Vide = desactive.
MCP_TOKEN=
TELEGRAM_BOT_TOKEN=
# Votre identifiant Telegram personnel : le bot ne repondra qu'a lui
TELEGRAM_CHAT_ID=

# --- E-mail (facultatif) : alertes et syntheses dans votre boite ---
# Gmail : SMTP_HOTE=smtp.gmail.com, SMTP_PORT=587, SMTP_UTILISATEUR=votre adresse,
# SMTP_MOT_DE_PASSE = "mot de passe d'application" Google (pas votre mot de passe habituel)
SMTP_HOTE=
SMTP_PORT=587
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
EMAIL_DESTINATAIRE=
EMAIL_EXPEDITEUR=

# --- Budget (F12) : se regle dans la page Reglages (IA en ligne 20 EUR + X 30 EUR par defaut) ---
BUDGET_MENSUEL_EUR=20

# --- Pages de lecture ---
# Adresse publique des pages : sert aux liens "Lire en entier" dans les messages
# (ex. https://veille.mesoutilsagile.com). Vide = messages complets, sans lien.
URL_PUBLIQUE=
# Vide = pas de mot de passe (usage sur votre Mac). Sur le VPS : mot de passe long obligatoire.
MOT_DE_PASSE_PAGES=

# --- Technique ---
BACKEND_PORT=8710
VEILLE_DB_PATH=data/veille.db
FUSEAU_HORAIRE=Europe/Paris
# 1 = taches automatiques actives (collecte, alertes, syntheses). Une seule instance a la fois !
SCHEDULER_ACTIF=1
# local (Mac/PC) ou vps (production : mot de passe des pages OBLIGATOIRE)
ENVIRONNEMENT=local
