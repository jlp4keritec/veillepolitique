# ============================================================
# VEILLE - modele de configuration
# Ce fichier est recopie en backend\.env au premier lancement.
# Le fichier .env ne va JAMAIS dans git (voir .gitignore).
# ============================================================

# --- Secrets (a renseigner vous-meme dans .env, jamais dans le chat) ---
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
# Votre identifiant Telegram personnel : le bot ne repondra qu'a lui
TELEGRAM_CHAT_ID=

# --- Budget (F12) : valeur initiale, ensuite modifiable par /param budget_mensuel_eur ---
BUDGET_MENSUEL_EUR=50

# --- Technique ---
BACKEND_PORT=8710
VEILLE_DB_PATH=data/veille.db
FUSEAU_HORAIRE=Europe/Paris
# 1 = taches automatiques actives (collecte, alertes, syntheses). Une seule instance a la fois !
SCHEDULER_ACTIF=1
